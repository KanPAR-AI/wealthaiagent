data: {"type": "message_delta", "delta": "\n\n```input_request\n{\"type\": \"input_request\", \"ask\": \"save_match_offer\", \"reason\": \"Saving keeps their birth date, birth time and birth place, the name you give them, and this scorecard \u2014 on your account, until you delete it. Deleting them removes all of it in one action; a dated record that you gave this permission is kept, with their name removed from it. They are not notified and do not need an account. There is no option to keep only the score: a score that cannot name what produced it can never be re-checked, or corrected when a birth detail changes.\", \"fields\": [{\"key\": \"save_match\", \"kind\": \"choice\", \"label\": \"Save this match?\", \"required\": false, \"allow_unknown\": false, \"options\": [{\"value\": \"save\", \"label\": \"Save to my matches\"}, {\"value\": \"skip\", \"label\": \"Don't save\"}]}, {\"key\": \"person2_name\", \"kind\": \"text\", \"label\": \"What should I call them?\", \"required\": true, \"allow_unknown\": false}]}\n```\n\n"}

