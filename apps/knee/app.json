{
  "expo": {
    "name": "KneeFit",
    "slug": "knee",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "scheme": "kneefit",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.yourfinadvisor.knee",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3",
      "appleTeamId": "Q2ZX496SN9"
    },
    "android": {
      "package": "com.yourfinadvisor.knee",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-video",
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.388592327571-b2qqp1ac7n8skgenmk4ac5dke6jmsv16"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "owner": "ravipradeep89",
    "icon": "./assets/images/icon.png"
  }
}
