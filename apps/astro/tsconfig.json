{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `jest` because this app's pure-logic modules (capability map, row
    // derivation) are unit-tested in the ROOT jest project — there is no RN
    // test renderer here, so anything testable is deliberately kept free of
    // react-native imports and tested from the workspace root.
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@firebase/auth": [
        "../../node_modules/@firebase/auth/dist/rn/index.rn.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
